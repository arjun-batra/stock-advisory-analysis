# Both values are intentionally public (client-side, RLS-gated) — same
# posture as pages/common.js's hardcoded anon key. See docs/handoff.md for
# the exact Vercel setup steps. Do not add any other variable here — this
# portal has no server-only secret (docs/design/admin-portal.md §16.7).

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-publishable-key>
